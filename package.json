{
  "name": "official-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/snap-scale.mjs --check && vite build && node --experimental-strip-types scripts/prerender.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "sitemap": "node --experimental-strip-types scripts/update-sitemap.mjs",
    "project-media": "node scripts/prepare-project-media.mjs",
    "olist-media": "node scripts/import-olist-media.mjs",
    "check:browser": "node --experimental-strip-types scripts/check-browser.mjs",
    "check:interactions": "node --experimental-strip-types scripts/check-interactions.mjs",
    "check:built": "node --experimental-strip-types scripts/check-built.mjs",
    "check:privacy": "node --experimental-strip-types scripts/check-privacy.mjs",
    "check:links": "node --experimental-strip-types scripts/check-links.mjs",
    "check:dev-media": "node --experimental-strip-types scripts/check-dev-media.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "og-card": "node --experimental-strip-types scripts/make-og-card.mjs",
    "dash-data": "node scripts/aggregate-dash-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
